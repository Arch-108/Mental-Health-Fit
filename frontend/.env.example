# Origin of your deployed backend (Render), e.g. https://your-app.onrender.com.
# Leave blank for local dev - it then auto-detects from the browser's own
# hostname, which also makes LAN demos (phone on the same WiFi) work with no
# manual IP editing.
VITE_API_ORIGIN=

# Optional - the Healthcare Resource Map works as a list without this, and
# upgrades to an interactive map once you add a key. Confirm free/student
# tier access with Panan first.
VITE_GOOGLE_MAPS_KEY=
