# Server
PORT=5000
NODE_ENV=development

# CORS - your deployed frontend URL (Vercel), plus localhost for dev
FRONTEND_URL=http://localhost:5173

# Database (MySQL) - fill in with your Railway/PlanetScale/local values
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telemedicine_db

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI Gateway (optional) - leave both blank to use the built-in rule-based
# fallback engine, which is fully functional with zero cost/setup. Set
# these once you've confirmed access/pricing with Panan to upgrade the
# Navigator/Brief/Follow-up features to a real LLM.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Never commit the real .env file - only this .env.example template
